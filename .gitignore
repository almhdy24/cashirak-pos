# Database files
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Session files
storage/sessions/*
!storage/sessions/.gitkeep

# Logs
storage/logs/*
!storage/logs/.gitkeep

# Backups
storage/backups/*
!storage/backups/.gitkeep

# Runtime storage files (device-specific, not for VCS)
storage/.device_id
storage/.license_data
storage/installed.lock

# Configuration with sensitive data
config.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
